{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gtavimap-one.vercel.app" }],
      "destination": "https://liveblip.com/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "liveblip.vercel.app" }],
      "destination": "https://liveblip.com/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/tiles/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
